<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FiloLaunchThemeBase" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/filo_splash_background</item>
        <item name="android:navigationBarColor">@color/filo_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="LaunchTheme" parent="FiloLaunchThemeBase" />
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/filo_splash_background</item>
        <item name="android:statusBarColor">@color/filo_splash_background</item>
        <item name="android:navigationBarColor">@color/filo_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
